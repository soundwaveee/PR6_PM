<Page x:Class="butakov_pr3.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:butakov_pr3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin"
                     Width="200"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="txtPassword"
                         Width="200"/>

            <TextBlock x:Name="txtBlockCaptcha"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Margin="5"
                       FontSize="16"/>

            <TextBox x:Name="txtBoxCaptcha"
                     Visibility="Collapsed"
                     Width="200"/>

            <StackPanel Orientation="Horizontal"
                        Height="80"
                        HorizontalAlignment="Center">

                <Button x:Name="btnEnterGuests"
                        Margin="5,15,5,5"
                        Content="Войти как гость"
                        Click="btnEnterGuests_Click"/>

                <Button x:Name="btnEnter"
                        Margin="5,15,5,5"
                        Content="Войти"
                        Click="btnEnter_Click"/>

            </StackPanel>

        </StackPanel>
    </Grid>
</Page>